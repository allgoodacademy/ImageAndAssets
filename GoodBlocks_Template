                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- STATISTIC -->
                            <div class="p-4 border border-gray-300 rounded-lg">
                                <h4 class="font-bold text-xl mb-2" style="color: var(--brand-secondary);">The # (Quantity)</h4>
