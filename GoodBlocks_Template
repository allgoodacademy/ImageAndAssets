        // Function to restart the entire learnable guide
        function restartLearnable() {
            currentStep = 0;
            renderStep();
        }

        // Function to set up accordion behavior on the relevant steps
        function setupAccordions() {
            document.querySelectorAll('.accordion-header').forEach(header => {
                header.removeEventListener('click', toggleAccordion); // Prevent double-listening
                header.addEventListener('click', toggleAccordion);
            });
        }

        // --- UPDATED: Focused Accordion Logic ---
        function toggleAccordion(event) {
            const header = event.currentTarget;
            const targetId = header.getAttribute('data-target');
            const targetContent = document.getElementById(targetId);
            const icon = header.querySelector('.accordion-icon');

            // Close all other open accordions in this step for focused learning ("One Thing" principle)
            document.querySelectorAll('.accordion-header').forEach(h => {
                const content = document.getElementById(h.getAttribute('data-target'));
                const otherIcon = h.querySelector('.accordion-icon');

                // Close it if it's not the target and it is currently visible
                if (content !== targetContent && !content.classList.contains('hidden')) {
                    content.classList.add('hidden');
                    otherIcon.style.transform = 'rotate(0deg)';
                    h.parentElement.classList.remove('shadow-md');
                }
            });

            // Toggle the clicked accordion
            if (targetContent.classList.contains('hidden')) {
                // Open the content
                targetContent.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
                header.parentElement.classList.add('shadow-md');
            } else {
                // Close the content
                targetContent.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
                header.parentElement.classList.remove('shadow-md');
            }
        }
        // --- END UPDATED ACCORDION ---

        // Function to render the current step
        function renderStep() {
            const stepData = courseSteps[currentStep];
            const maxProgress = totalContentSteps;
            const navBar = document.getElementById('navigation-bar'); // Reference the navigation bar
            
            // --- NEW: Dynamic Content Injection and Header Update ---
            // 1. Update Main Header with Skill Name
            document.querySelector('header h1 span').textContent = goodBlockConfig.skillName; 

            let stepBody = stepData.body;
            let stepTitle = stepData.title;

            // 2. Inject Dynamic Content into Step 0 (Welcome Screen)
            if (currentStep === 0) {
                stepBody = stepBody.replace('{{topic}}', goodBlockConfig.topicName);
                stepBody = stepBody.replace('{{objectives}}', goodBlockConfig.objectives);
            }

            // 3. Render Content
            contentContainer.innerHTML = `
                <h2 class="text-2xl font-bold text-gray-800 mb-6 font-georgia">${stepTitle}</h2>
                <div>${stepBody}</div>
            `;
            // --- END NEW DYNAMIC LOGIC ---
            
            // 4. Update Progress Bar
            let progress = 0;
            if (currentStep > 0 && currentStep <= maxProgress) {
                // Calculate progress based on steps 1 through the final content step (index 11)
                progress = ((currentStep) / maxProgress) * 100; 
            } else if (currentStep === maxProgress) { // Final screen (index 11)
                progress = 100;
            }
            progressBarFill.style.width = `${progress}%`;

            // 5. Update Navigation Buttons
            backButton.classList.remove('hidden');
            nextButton.classList.remove('hidden');

            // FIX: Control visibility of the Header Restart Button (Home Icon) cleanly
            if (currentStep > 0) {
                restartButton.classList.remove('hidden'); 
            } else {
                restartButton.classList.add('hidden'); 
            }

            // --- Navigation Bar (Footer) Button Logic ---
            if (currentStep === 0) {
                // Center the button when starting
                navBar.classList.remove('justify-between');
                navBar.classList.add('justify-center');
                
                backButton.classList.add('hidden');
                nextButton.textContent = "Start GoodBlock";
            } else if (currentStep === courseSteps.length - 1) { // Last step (index 11)
                // Ensure buttons are spaced out for multi-step navigation
                navBar.classList.remove('justify-center');
                navBar.classList.add('justify-between');
                
                nextButton.textContent = "Restart GoodBlock";
            } else {
                // Ensure buttons are spaced out for multi-step navigation
                navBar.classList.remove('justify-center');
                navBar.classList.add('justify-between');
                
                nextButton.textContent = "Next";
            }

            if (currentStep > 0) {
                backButton.textContent = "Back";
            }
            
            // 6. Setup Accordion Listeners if on the right step
            if (currentStep === 4 || currentStep === 9 || currentStep === 10) {
                setTimeout(setupAccordions, 0); 
            }
        }

        // Function to handle navigation
        function navigate(direction) {
            const lastStepIndex = courseSteps.length - 1;

            if (currentStep === 0 && direction === 1) {
                currentStep = 1; 
            } else if (currentStep === lastStepIndex && direction === 1) {
                // Handle restart from the conclusion page
                restartLearnable();
                return;
            } else {
                const newStep = currentStep + direction;
                if (newStep >= 0 && newStep <= lastStepIndex) {
                    currentStep = newStep;
                }
            }
            renderStep();
        }

        // Initial render on load
        document.addEventListener('DOMContentLoaded', renderStep);
    </script>
